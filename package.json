{
  "name": "mr-excel",
  "version": "7.0.1",
  "type": "module",
  "main": "dist/excel-table.cjs",
  "module": "dist/excel-table.js",
  "types": "dist/excel-table.d.ts",
  "exports": {
    ".": {
      "import": "./dist/excel-table.js",
      "require": "./dist/excel-table.cjs",
      "default": "./dist/excel-table.umd.cjs",
      "browser": "./dist/excel-table.iife.js",
      "node": "./dist/excel-table.cjs",
      "amd": "./dist/excel-table.amd.js",
      "system": "./dist/excel-table.system.js"
    }
  },
  "scripts": {
    "build1": "tsc --noEmit && vite build",
    "start": "tsc",
    "vite:build": "vite build",
    "prebuild": "npm run start",
    "build": "npm run vite:build",
    "postbuild": "npm run api-documenter:markdown && echo build DONE!",
    "dev": "tsc -w",
    "api-extractor": "api-extractor",
    "api-extractor:run":"api-extractor run",
    "preapi-documenter:markdown":"npm run api-extractor:run",
    "api-documenter:markdown":"api-documenter markdown -i temp -o docs",
    "test": "jest",
    "test:clear": "jest --clearCache",
    "test:coverage": "jest --coverage",
    "test:coverage-text-summary": "jest --coverage --coverageReporters=\"text-summary\"",
    "test:coverage-json-summary": "jest --coverage --coverageReporters=\"json-summary\""
  },
  "description": "A versatile JavaScript library for effortlessly generating .xlsx files from input objects. Seamlessly create Excel spreadsheets with data, formatting, formulas, and more.",
  "keywords": [
    "excel",
    "excel style",
    "excel merge",
    "excel format",
    "excel comment",
    "comment",
    "image",
    "excel image",
    "multi cell style",
    "multi cell style excel",
    "excel-generation",
    "data-to-excel",
    "excel-creator",
    "object-to-excel",
    "multi-sheet-excel",
    "excel-generation",
    "spreadsheet",
    "excel-export",
    "export-to-excel",
    "data-conversion",
    "excel-format",
    "table-to-excel",
    "json-to-excel",
    "excel-util",
    "read excel",
    "checkbox",
    "checkbox excel",
    "xlsx",
    "xlsx comment",
    "xlsx style",
    "xlsx merge",
    "xlsx format",
    "xlsx image",
    "multi cell style xlsx",
    "xlsx-generation",
    "data-to-xlsx",
    "xlsx-creator",
    "object-to-xlsx",
    "data-validation"
  ],
  "author": "M.Rezaei",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@microsoft/api-documenter": "^7.30.5",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/file-saver": "2.0.7",
    "cross-fetch": "^4.1.0",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadrezaeicode/mr-excel-repo.git"
  },
  "bugs": {
    "url": "https://github.com/mohammadrezaeicode/mr-excel-repo.git/issues",
    "email": "mohammadrezaeicode@gmail.com"
  },
  "publishConfig": {
    "@mohammadrezaeicode:registry": "https://npm.pkg.github.com"
  },
  "homepage": "https://github.com/mohammadrezaeicode/mr-excel-repo#readme",
  "dependencies": {
    "file-saver": "2.0.5",
    "jszip": "3.10.1"
  }
}
